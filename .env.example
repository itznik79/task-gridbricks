# Copy to .env and fill in values
# Never commit .env to version control

# Database
# Port 5434 avoids conflicts with local Postgres (5432) and other Docker projects (5433)
DATABASE_URL=postgresql+psycopg2://wind:wind@localhost:5434/wind_forecast

# Elexon API (public, no key required)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Ingestion — set a secret to enable POST /api/v1/ingest; leave empty to disable
# Pass the same value as the X-Ingestion-Token header when calling the endpoint
INGESTION_TOKEN=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Frontend (Vite env vars — prefix with VITE_)
VITE_API_URL=http://localhost:8000/api/v1
